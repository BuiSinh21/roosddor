# Copy thanh deploy/.env.prod va dien gia tri that. Dung voi:
#   docker compose -f deploy/compose.prod.yml --env-file deploy/.env.prod up -d
#
# Trong CI (GitHub Actions), file nay khong duoc dung truc tiep - workflow deploy.yml tu sinh
# .env tuong duong tren runner tu GitHub Environment "production" (vars) roi scp len VPS.

# --- Image (build/push boi CI) ---
IMAGE_PREFIX=ghcr.io/your-org
TAG=latest

# --- Port app expose ra host (tuy chon, default 3020) ---
APP_PORT=3020
